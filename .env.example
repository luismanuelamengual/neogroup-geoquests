# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Tag Manager (container ID, e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Session timeout in seconds (default: 2592000 = 30 days)
# AUTH_SESSION_MAX_AGE=2592000

# Email (Resend) — https://resend.com (free tier: 3.000 mails/month)
# Without RESEND_API_KEY the verification / reset links are logged to the server console instead.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=GeoQuests <noreply@geoquests.app>

# Google Street View — free services: Street View Image Metadata (server) + Maps Embed API (browser).
# Google Cloud Console → APIs & Services: enable "Street View Static API" and "Maps Embed API" and create two keys:
#   - server key (finds panoramas): restrict it to "Street View Static API";
#   - browser key (embed iframe, visible in the page): restrict it to "Maps Embed API" + your site (HTTP referrers).
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Database (NeORM resolves the data source from these variables)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geoquests
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Scheduled jobs (Vercel Cron, see vercel.json): Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -base64 32. Without it the cron endpoints reject every request.
CRON_SECRET=

# Freemium: free with ads, or a one-off payment for 1 year without ads.
# "true" turns it on (ads + buy button); anything else turns it off and the app has no ads nor payments.
# Read at runtime: on Vercel, redeploy after changing it.
FREEMIUM_ENABLED=false

# Google AdSense — https://adsense.google.com: the publisher id (ca-pub-…) and the id of a responsive display ad unit.
# Without them (outside production) a placeholder shows where the ads go.
ADSENSE_CLIENT_ID=ca-pub-6683636497125407
ADSENSE_SLOT_ID=6141220096

# Lemon Squeezy — https://lemonsqueezy.com: a single-payment product "1 year without ads".
#   API key: Settings → API · Store id: Settings → Stores · Variant id: the product's variant
#   Webhook: Settings → Webhooks → <APP_URL>/api/lemonSqueezyWebhook, events order_created + order_refunded
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
