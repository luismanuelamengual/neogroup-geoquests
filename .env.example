# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Session timeout in seconds (default: 2592000 = 30 days)
# AUTH_SESSION_MAX_AGE=2592000

# Email (Resend) — https://resend.com (free tier: 3.000 mails/month)
# Without RESEND_API_KEY the verification / reset links are logged to the server console instead.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=GeoQuests <noreply@geoquests.app>

# Mapillary (street-level imagery, free) — https://www.mapillary.com/dashboard/developers
# Create an application and copy its "Client Token" (starts with MLY|...).
# The server uses it to search images; the browser uses it to render them.
MAPILLARY_ACCESS_TOKEN=MLY|your-client-token
NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=MLY|your-client-token

# Database (NeORM resolves the data source from these variables)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geoquests
DB_USERNAME=postgres
DB_PASSWORD=postgres
